{
  "name": "deployment-dash-intelligence-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build:cli && node --test tests/*.test.mjs",
    "build:cli": "tsc --strict --skipLibCheck --target ES2022 --module ES2022 --moduleResolution Bundler --outDir .cli-build src/analyzer.ts src/sarif.ts",
    "deploydash": "npm run build:cli && node bin/deploydash.mjs"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
