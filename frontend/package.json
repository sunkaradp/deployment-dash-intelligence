{
  "name": "deployment-dash-intelligence-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build:cli && node --test tests/*.test.mjs",
    "build:cli": "tsc --strict --skipLibCheck --target ES2022 --module ES2022 --moduleResolution Bundler --outDir .cli-build src/analyzer.ts src/sarif.ts",
    "deploydash": "npm run build:cli && node bin/deploydash.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
